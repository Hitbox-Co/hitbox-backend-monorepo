# Names only — never put real values in this file.
# Copy the variables you need into .env (which is git-ignored).

# ── NFC chip UID key ─────────────────────────────────────────────────────────
# At least 32 characters. Do not change it once tags have been registered:
# existing NfcTag.tagUidHash rows are not re-hashed by a rotation.
NFC_TAG_UID_KEY=
NFC_TAG_KEY_REFERENCE=

# ── NFC batch keys (Key 00/01/02) ────────────────────────────────────────────
# KMS key (ARN / key id) that wraps new key sets. Stored on each NfcKeySet.
NFC_KMS_KEY_REF=
# DEVELOPMENT ONLY — local stand-in for a KMS, at least 32 characters.
# The local wrapper refuses to start when NODE_ENV=production.
NFC_LOCAL_WRAP_KEY=
