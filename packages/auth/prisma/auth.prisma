/// Clerk webhook deliveries, keyed by the svix-id header.
/// Presence of a row = the delivery has been processed (idempotency guard).
model AuthWebhookEvent {
    id          String   @id // svix-id header — unique per delivery
    type        String
    payload     Json
    processedAt DateTime @default(now()) @map("processed_at")

    @@index([processedAt])
    @@map("auth_webhook_events")
}
