/// Clerk webhook deliveries, keyed by the `svix-id` header.
/// Presence of a row = the delivery has already been processed (idempotency
/// guard against replays). No relation to User on purpose: the payload arrives
/// before the local projection exists, and auth must never depend on users.
model AuthWebhookEvent {
  id          String    @id
  /// Human-readable record id (`awh…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  eventType   String
  payload     Json
  processedAt DateTime?
  receivedAt  DateTime
}
