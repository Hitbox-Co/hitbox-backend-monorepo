  code       String    @unique
  name       String
  currency   Currency
  isActive   Boolean
  isDefault  Boolean
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  marketCountrys MarketCountry[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  users         User[]
  productPrices ProductPrice[]
  orders        Order[]
}

/// Maps an ISO country code to its market. `countryCode` is globally unique, so
/// a country belongs to exactly one market and resolution is unambiguous.
model MarketCountry {
  id          String   @id @db.Uuid
  marketId    String   @db.Uuid
  market      Market   @relation(fields: [marketId], references: [id])
  countryCode String   @unique
  createdAt   DateTime
}

// ───── source: packages\media\prisma\media.prisma ──────────────────────────────────

// ============================================================================
// MEDIA MODULE SCHEMA  (packages/media/prisma/media.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: MediaAsset
//
// The single upload registry for the whole platform. Nothing else stores a
// storage path: products reference assets via ProductImage, content bundles via
// ContentBundleItem. One place to enforce virus scanning and one place to
// revoke a file.
// ============================================================================

/// An uploaded file. `storageRef` is the object-store key — never a public URL,
/// so signed-URL policy stays a runtime decision. `checksum` deduplicates and
/// detects corruption; `virusScanStatus` gates serving (only CLEAN is
/// servable). The four nullable owner columns scope the asset to whichever
/// entity it belongs to; `uploadedBy` always records the actor.
model MediaAsset {
  id              String          @id @db.Uuid
  assetType       AssetType
  storageRef      String
  fileName        String
  mimeType        String
  sizeBytes       Int?
  checksum        String?
  virusScanStatus VirusScanStatus
  uploadedById    String          @db.Uuid
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])

  // ── Optional ownership scoping — at most one is normally set ──────────────
  organizationId String?           @db.Uuid
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  artistId       String?           @db.Uuid
  artist         Artist?           @relation(fields: [artistId], references: [id])
  productId      String?           @db.Uuid
  product        Product?          @relation(fields: [productId], references: [id])
  collectionId   String?           @db.Uuid
  collection     ArtistCollection? @relation(fields: [collectionId], references: [id])

  archivedAt DateTime?
  createdAt  DateTime

  // ── Cross-module back-relations ───────────────────────────────────────────
  productImages      ProductImage[]
  contentBundleItems ContentBundleItem[]
}

/// What the file is for. Drives storage tier, retention and who may read it —
/// EXCLUSIVE_CONTENT and LEGAL_DOCUMENT are never publicly servable.
enum AssetType {
  DROP_IMAGE
  PROFILE_IMAGE
  EXCLUSIVE_CONTENT
  LEGAL_DOCUMENT
  SUPPLY_SPREADSHEET
  OTHER
}

/// Malware scan outcome. Only CLEAN may be served; SKIPPED covers trusted
/// internal uploads that bypassed the scanner.
enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

// ───── source: packages\notifications\prisma\notifications.prisma ──────────────────

// ============================================================================
// NOTIFICATIONS MODULE SCHEMA  (packages/notifications/prisma/notifications.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: NotificationTemplate, Notification, NotificationPreference
// ============================================================================

/// The message body for one event type on one channel. `eventType` is unique,
/// so the domain event name is the lookup key and publishers never hard-code
/// copy. `parameters` lists the placeholders the template expects, which lets
/// the sender validate its payload before dispatch.
model NotificationTemplate {
  id           String              @id @db.Uuid
  eventType    String              @unique
  channel      NotificationChannel
  subject      String?
  bodyTemplate String
  parameters   String[]
  isActive     Boolean
  createdAt    DateTime
  updatedAt    DateTime

  notifications Notification[]
}

/// One rendered delivery to one user. `payload` keeps the values the template
/// was filled with, so the message can be re-rendered or audited later.
/// `failureReason` is retained on FAILED rows for retry triage.
model Notification {
  id            String               @id @db.Uuid
  userId        String               @db.Uuid
  user          User                 @relation(fields: [userId], references: [id])
  templateId    String               @db.Uuid
  template      NotificationTemplate @relation(fields: [templateId], references: [id])
  channel       NotificationChannel
  payload       Json?
  status        NotificationStatus
  sentAt        DateTime?
  readAt        DateTime?
  failureReason String?
  createdAt     DateTime
}

/// A user's opt-in per channel. Unique per (user, channel); a missing row means
/// the channel default applies.
model NotificationPreference {
  id      String              @id @db.Uuid
  userId  String              @db.Uuid
  user    User                @relation(fields: [userId], references: [id])
  channel NotificationChannel
  enabled Boolean

  @@unique([userId, channel])
}

/// Delivery channel. Push/SMS join this enum when those transports ship.
enum NotificationChannel {
  EMAIL
  IN_APP
}

/// Delivery state. READ only applies to IN_APP.
enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

// ───── source: packages\orders\prisma\orders.prisma ────────────────────────────────

// ============================================================================
// ORDERS MODULE SCHEMA  (packages/orders/prisma/orders.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Order, OrderAddress, InventoryReservation
//
// The purchase record. Money movement is the payments module; margin and
// royalty postings are the finance module. This module owns only the order's
// own lifecycle and the stock it is holding.
// ============================================================================

/// A purchase. `skuId` is nullable because a serialized unit is only assigned
/// once payment settles — before that the order holds an InventoryReservation.
/// `unitPrice`, `amount`, `currency` and `gateway` are snapshotted at purchase
/// time so later catalog or market edits never rewrite an order's totals.
model Order {
  id             String          @id @db.Uuid
  buyerId        String          @db.Uuid
  buyer          User            @relation(fields: [buyerId], references: [id])
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  skuId          String?         @db.Uuid
  sku            Sku?            @relation(fields: [skuId], references: [id])
  quantity       Int
  organizationId String?         @db.Uuid
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  marketId       String?         @db.Uuid
  market         Market?         @relation(fields: [marketId], references: [id])
  status         OrderStatus
  unitPrice      Decimal         @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  currency       Currency
  gateway        PaymentGateway
  /// When the buyer accepted the drop's terms — evidence for disputes.
  termsAcceptedAt DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNote    String?
  placedAt        DateTime
  updatedAt       DateTime
  archivedAt      DateTime?

  // ── Own-module back-relations ─────────────────────────────────────────────
  orderAddresss         OrderAddress[]
  inventoryReservations InventoryReservation[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  paymentTransactions PaymentTransaction[]
  refundRequests      RefundRequest[]
  royaltyLedgerEntrys RoyaltyLedgerEntry[]
  financeLedgerEntrys FinanceLedgerEntry[]
}

/// A frozen copy of the shipping or billing address for one order. The address
/// lines are duplicated (not read through `sourceAddressId`) on purpose: an
/// order must always show where it was actually sent, even after the user edits
/// or deletes the address book entry. Unique per (order, usage).
model OrderAddress {
  id              String       @id @db.Uuid
  orderId         String       @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id])
  usage           AddressUsage
  /// Provenance pointer to the Address it was copied from; nullable because the
  /// source may be gone and the snapshot must remain valid regardless.
  sourceAddressId String?      @db.Uuid
  sourceAddress   Address?     @relation(fields: [sourceAddressId], references: [id])
  label           AddressLabel
  labelCustom     String?
  recipientName   String
  line1           String
  line2           String?
  city            String
  state           String?
  postalCode      String
  countryCode     String
  phone           String?
  createdAt       DateTime

  @@unique([orderId, usage])
}

/// A temporary hold on a specific SKU while an order is paying. HELD expires at
/// `expiresAt` (a sweeper RELEASEs it); COMMITTED means payment settled and the
/// SKU is now the order's. This is what stops two buyers claiming one unit.
model InventoryReservation {
  id        String            @id @db.Uuid
  orderId   String            @db.Uuid
  order     Order             @relation(fields: [orderId], references: [id])
  skuId     String            @db.Uuid
  sku       Sku               @relation(fields: [skuId], references: [id])
  status    ReservationStatus
  expiresAt DateTime
  createdAt DateTime
}

/// Order lifecycle. Fulfilment states (SHIPPED/DELIVERED) apply to physical
/// items; REFUNDED is set once the payments module completes a refund.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// Which role an OrderAddress snapshot plays for its order.
enum AddressUsage {
  SHIPPING
  BILLING
}

/// State of a stock hold: HELD (pending payment), COMMITTED (payment settled),
/// RELEASED (expired or cancelled — the SKU is available again).
enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
}

