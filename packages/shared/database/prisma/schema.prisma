// ============================================================================
// ORDERS MODULE SCHEMA  (packages/orders/prisma/orders.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Order, OrderAddress, InventoryReservation
//
// The purchase record. Money movement is the payments module; margin and
// royalty postings are the finance module. This module owns only the order's
// own lifecycle and the stock it is holding.
// ============================================================================

/// A purchase. `skuId` is nullable because a serialized unit is only assigned
/// once payment settles — before that the order holds an InventoryReservation.
/// `unitPrice`, `amount`, `currency` and `gateway` are snapshotted at purchase
/// time so later catalog or market edits never rewrite an order's totals.
model Order {
  id             String          @id @db.Uuid
  buyerId        String          @db.Uuid
  buyer          User            @relation(fields: [buyerId], references: [id])
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id])
  variantId      String?         @db.Uuid
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  skuId          String?         @db.Uuid
  sku            Sku?            @relation(fields: [skuId], references: [id])
  quantity       Int
  organizationId String?         @db.Uuid
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  marketId       String?         @db.Uuid
  market         Market?         @relation(fields: [marketId], references: [id])
  status         OrderStatus
  unitPrice      Decimal         @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  currency       Currency
  gateway        PaymentGateway
  /// When the buyer accepted the drop's terms — evidence for disputes.
  termsAcceptedAt DateTime?
  /// The ProductClaim that took ownership of this order's unit, and when.
  /// Payment and ownership are decoupled: an order is PAID on day 1 and may be
  /// claimed on day 6, or never. Royalty accrues at the claim, so this is the
  /// column that says whether this order has earned anyone anything yet.
  /// Deliberately NOT a foreign key — claims owns that record and a revocation
  /// must never be blocked by an order row pointing at it.
  claimId         String?   @db.Uuid
  claimedAt       DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  trackingNote    String?
  placedAt        DateTime
  updatedAt       DateTime
  archivedAt      DateTime?

  // ── Own-module back-relations ─────────────────────────────────────────────
  orderAddresss         OrderAddress[]
  inventoryReservations InventoryReservation[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  paymentTransactions PaymentTransaction[]
  refundRequests      RefundRequest[]
  disputeCases        DisputeCase[]
  royaltyLedgerEntrys RoyaltyLedgerEntry[]
  financeLedgerEntrys FinanceLedgerEntry[]
  adjustmentEntrys    AdjustmentEntry[]
  /// The statutory customer invoice. One per order, written once payment
  /// settles — see packages/tax.
  invoice             Invoice?

  /// The admin order list is "newest first, filtered by org/status"; the claim
  /// lookup is how an accrual finds the order behind a claimed unit.
  @@index([organizationId, placedAt])
  @@index([status, placedAt])
  @@index([skuId])
  @@index([claimId])
}

/// A frozen copy of the shipping or billing address for one order. The address
/// lines are duplicated (not read through `sourceAddressId`) on purpose: an
/// order must always show where it was actually sent, even after the user edits
/// or deletes the address book entry. Unique per (order, usage).
model OrderAddress {
  id              String       @id @db.Uuid
  orderId         String       @db.Uuid
  order           Order        @relation(fields: [orderId], references: [id])
  usage           AddressUsage
  /// Provenance pointer to the Address it was copied from; nullable because the
  /// source may be gone and the snapshot must remain valid regardless.
  sourceAddressId String?      @db.Uuid
  sourceAddress   Address?     @relation(fields: [sourceAddressId], references: [id])
  label           AddressLabel
  labelCustom     String?
  recipientName   String
  line1           String
  line2           String?
  city            String
  state           String?
  postalCode      String
  countryCode     String
  phone           String?
  createdAt       DateTime

  @@unique([orderId, usage])
}

/// A temporary hold on a specific SKU while an order is paying. HELD expires at
/// `expiresAt` (a sweeper RELEASEs it); COMMITTED means payment settled and the
/// SKU is now the order's. This is what stops two buyers claiming one unit.
model InventoryReservation {
  id        String            @id @db.Uuid
  orderId   String            @db.Uuid
  order     Order             @relation(fields: [orderId], references: [id])
  skuId     String            @db.Uuid
  sku       Sku               @relation(fields: [skuId], references: [id])
  status    ReservationStatus
  expiresAt DateTime
  createdAt DateTime

  /// One live hold per unit: the partial index cannot be expressed in Prisma,
  /// so the sweeper and the reserve path both filter on (skuId, status).
  @@index([skuId, status])
  /// The expiry sweeper's scan.
  @@index([status, expiresAt])
}

/// Order lifecycle. Fulfilment states (SHIPPED/DELIVERED) apply to physical
/// items; REFUNDED is set once the payments module completes a refund.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

/// Which role an OrderAddress snapshot plays for its order.
enum AddressUsage {
  SHIPPING
  BILLING
}

/// State of a stock hold: HELD (pending payment), COMMITTED (payment settled),
/// RELEASED (expired or cancelled — the SKU is available again).
enum ReservationStatus {
  HELD
  COMMITTED
  RELEASED
}

// ───── source: packages\organizations\prisma\organizations.prisma ──────────────────

// ============================================================================
// ORGANIZATIONS MODULE SCHEMA  (packages/organizations/prisma/organizations.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Organization
//
// The tenant root. Almost every commercial record (product, order, media,
// royalty rule, gateway config) carries an optional organizationId, and
// RoleAssignment uses an Organization id as its ORG scope.
// ============================================================================

/// A commercial entity on the platform: the HITBOX organization itself, a
/// BRAND, or a solo artist operating as their own org (ARTIST_INDIVIDUAL).
model Organization {
  id         String           @id @db.Uuid
  name       String
  type       OrganizationType
  slug       String           @unique
  isActive   Boolean
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  // ── Cross-module back-relations ───────────────────────────────────────────
  artists               Artist[]
  artistCollections     ArtistCollection[]
  products              Product[]
  artistBrandLinks      ArtistBrandLink[]
  roleAssignments       RoleAssignment[]
  mediaAssets           MediaAsset[]
  orders                Order[]
  paymentGatewayConfigs PaymentGatewayConfig[]
  royaltyRules          RoyaltyRule[]
  /// Royalties owed TO this organization (a brand deal), as distinct from the
  /// rules that define them — named relations because an org can be both the
  /// scope a rule applies to and the party it pays.
  royaltyLedgerEntrys   RoyaltyLedgerEntry[] @relation("RoyaltyLedgerEntry_payeeOrganization")
  royaltyPayouts        RoyaltyPayout[]
  /// Invoices issued for this organization's drops — see packages/tax.
  invoices              Invoice[]
  /// Pending staff invitations scoped to this organization.
  staffInvitations      StaffInvitation[]
}

/// Which kind of entity an Organization represents. HITBOX is the platform's
/// own org (there is exactly one); ARTIST_INDIVIDUAL lets a solo artist hold
/// commercial records without a separate brand behind them.
enum OrganizationType {
  HITBOX
  BRAND
  ARTIST_INDIVIDUAL
}

// ───── source: packages\payments\prisma\payments.prisma ────────────────────────────

// ============================================================================
// PAYMENTS MODULE SCHEMA  (packages/payments/prisma/payments.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: PaymentTransaction, PaymentGatewayConfig, PaymentWebhookEvent,
//       RefundRequest, DisputeCase
//
// Everything that talks to a payment provider. No card data or credentials are
// ever stored — only opaque gateway references and a secrets-manager pointer.
// ============================================================================

/// One charge attempt against a gateway for an order. `idempotencyKey` is
/// globally unique, which is what makes a retried charge safe. `needsReview`
/// plus the reviewer columns support manual settlement review; `gatewayRef` is
/// the provider's own id for reconciliation.
model PaymentTransaction {
  id             String                   @id @db.Uuid
  orderId        String                   @db.Uuid
  order          Order                    @relation(fields: [orderId], references: [id])
  gateway        PaymentGateway
  gatewayRef     String?
  status         PaymentTransactionStatus
  idempotencyKey String                   @unique
  amount         Decimal                  @db.Decimal(12, 2)
  currency       Currency
  needsReview    Boolean
  /// Reviewer's user id. Intentionally not a foreign key — a financial review
  /// record must outlive the reviewer's account.
  reviewedById   String?                  @db.Uuid
  reviewedAt     DateTime?
  reviewNote     String?
  failureReason  String?
  /// When the gateway confirmed settlement. Distinct from `updatedAt`, which
  /// moves for a review note too.
  settledAt      DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  disputeCases DisputeCase[]

  @@index([orderId])
  @@index([status, createdAt])
  @@index([gatewayRef])
}

/// Gateway credentials binding at one scope: PLATFORM-wide, per ORGANIZATION,
/// or per DROP. `credentialsRef` is a pointer into the secrets manager — the
/// actual keys are never in this database.
model PaymentGatewayConfig {
  id             String             @id @db.Uuid
  scope          GatewayConfigScope
  organizationId String?            @db.Uuid
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  gateway        PaymentGateway
  isDefault      Boolean
  credentialsRef String
  status         ConfigStatus
  createdAt      DateTime
  updatedAt      DateTime
}

/// Raw gateway webhook deliveries, keyed by the provider's event id (`id`), so
/// a row's existence is the replay guard. `signatureVerified` is recorded
/// rather than assumed, and `processingError` keeps failed deliveries around
/// for replay instead of dropping them.
model PaymentWebhookEvent {
  id                String         @id
  provider          PaymentGateway
  eventType         String
  payload           Json
  signatureVerified Boolean
  processedAt        DateTime?
  processingError    String?
  receivedAt         DateTime
}

/// A refund through its approval chain. `physicalReturnConfirmedAt` gates
/// refunds on physical goods — money moves only once the item is back.
/// `gatewayRefundId` links to the provider's refund object.
///
/// The columns after the return gate exist because a HitBox refund is not only
/// a money movement: the item carries an NFC tag that may already have been
/// claimed. `nfcTagCondition` is what the warehouse found, `claimRevokedAt`
/// records that ownership was taken back, and `resaleBlockedUntil` is the
/// quarantine window on a tag that came back damaged — a tag that stops
/// responding must not reappear on the resale market the next day.
model RefundRequest {
  id                        String       @id @db.Uuid
  orderId                   String       @db.Uuid
  order                     Order        @relation(fields: [orderId], references: [id])
  requestedById             String       @db.Uuid
  requestedBy               User         @relation("User_requestedBy", fields: [requestedById], references: [id])
  reason                    String
  reasonCode                RefundReason
  status                    RefundStatus
  amount                    Decimal      @db.Decimal(12, 2)
  currency                  Currency
  /// False for a digital-only order, which skips the AWAITING_RETURN hold.
  physicalReturnRequired    Boolean
  physicalReturnConfirmedAt DateTime?
  /// What the returned tag looked like. Null until the return is inspected.
  nfcTagCondition           NfcTagCondition?
  approvedById              String?      @db.Uuid
  approvedBy                User?        @relation("User_approvedBy", fields: [approvedById], references: [id])
  approvedAt                DateTime?
  rejectionReason           String?
  gatewayRefundId           String?
  /// When the gateway confirmed the money moved.
  processedAt               DateTime?
  /// Set when the buyer's claim on the item was taken back as part of this
  /// refund. Plain timestamp — the claim itself is the claims module's record.
  claimRevokedAt            DateTime?
  /// Quarantine window on the returned tag (default 90 days on a damaged or
  /// missing tag). Null means the unit is free to re-enter circulation.
  resaleBlockedUntil        DateTime?
  createdAt                 DateTime
  updatedAt                 DateTime

  @@index([orderId])
  @@index([status, createdAt])
}

/// A chargeback or payment dispute raised at the provider.
///
/// Separate from RefundRequest on purpose: a refund is something HitBox
/// decides to do, a dispute is something a card network does to HitBox. They
/// have different clocks (`evidenceDueBy` is the network's deadline, and
/// missing it loses the case by default), different actors, and different
/// financial consequences — a lost dispute costs the sale AND a fee, which is
/// posted as two adjustment entries rather than one refund.
model DisputeCase {
  id                   String             @id @db.Uuid
  orderId              String             @db.Uuid
  order                Order              @relation(fields: [orderId], references: [id])
  paymentTransactionId String?            @db.Uuid
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  gateway              PaymentGateway
  /// The provider's dispute id. Unique, so a redelivered dispute webhook
  /// updates the case instead of opening a second one.
  gatewayCaseRef       String?            @unique
  reasonCode           DisputeReason
  reason               String?
  status               DisputeStatus
  amount               Decimal            @db.Decimal(12, 2)
  currency             Currency
  /// Fee the network charges regardless of outcome, when one applies.
  feeAmount            Decimal?           @db.Decimal(12, 2)
  /// The network's evidence deadline. Missing it is a loss by default, which
  /// is why it is a column and not a note.
  evidenceDueBy        DateTime?
  evidenceSubmittedAt  DateTime?
  evidence             Json?
  /// Resolver's user id. Not a foreign key — the case outlives the account.
  resolvedById         String?            @db.Uuid
  resolvedAt           DateTime?
  resolutionNote       String?
  openedAt             DateTime
  createdAt            DateTime
  updatedAt            DateTime

  @@index([orderId])
  @@index([status, evidenceDueBy])
}

/// Charge attempt state. NEEDS_REVIEW parks a transaction for a human instead
/// of failing it outright.
enum PaymentTransactionStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  NEEDS_REVIEW
}

/// How widely a gateway config applies. More specific scopes win: DROP over
/// ORGANIZATION over PLATFORM.
enum GatewayConfigScope {
  PLATFORM
  ORGANIZATION
  DROP
}

/// Whether a gateway config is live.
enum ConfigStatus {
  ACTIVE
  INACTIVE
}

/// Refund lifecycle. AWAITING_RETURN is the physical-goods hold before
/// approval; PROCESSED means the gateway confirmed the money moved.
enum RefundStatus {
  REQUESTED
  AWAITING_RETURN
  APPROVED
  PROCESSED
  REJECTED
}

/// Why a refund was asked for. The free-text `reason` carries the detail; this
/// is what reporting groups by — "defective tag" is a manufacturing signal,
/// "changed mind" is not.
enum RefundReason {
  DEFECTIVE_ITEM
  DEFECTIVE_TAG
  NOT_AS_DESCRIBED
  NOT_DELIVERED
  DUPLICATE_CHARGE
  BUYER_CHANGED_MIND
  FRAUDULENT_CHARGE
  OTHER
}

/// Condition of the NFC tag on a returned item. DAMAGED / MISSING / TAMPERED
/// all quarantine the unit from resale; INTACT lets it go back into stock.
enum NfcTagCondition {
  INTACT
  DAMAGED
  MISSING
  TAMPERED
}

/// Dispute lifecycle, mirroring how card networks actually run one: it opens,
/// HitBox either submits evidence or accepts, and the network decides. WON /
/// LOST / ACCEPTED are terminal.
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  EVIDENCE_SUBMITTED
  WON
  LOST
  ACCEPTED
  WITHDRAWN
}

/// The network's stated reason for the dispute.
enum DisputeReason {
  FRAUDULENT
  PRODUCT_NOT_RECEIVED
  PRODUCT_UNACCEPTABLE
  DUPLICATE
  SUBSCRIPTION_CANCELED
  CREDIT_NOT_PROCESSED
  UNRECOGNIZED
  OTHER
}

