// ============================================================================
// SKUS MODULE SCHEMA  (packages/skus/prisma/skus.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Sku
//
// The serialized-item registry: one row per physical collectible, its NFC tag
// binding, and its current owner. This is the platform's most security-
// sensitive table — the digital twin of an object in someone's hands — which
// is why it is its own module rather than a folder inside products.
// ============================================================================

/// One serialized unit of a product. `serialNumber` is unique within the
/// product ("#014 of 500"). Ownership, NFC tag custody and resale eligibility
/// all live on this row; the provenance history is append-only in the claims
/// module (ProductHistory + BlockchainLedger).
model Sku {
  id          String  @id @db.Uuid
  skuCode     String  @unique
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id])
  variantId   String? @db.Uuid
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  /// Position within the product's edition; unique per product (see @@unique).
  serialNumber Int
  /// Current holder. Null until first claimed.
  ownerId      String?       @db.Uuid
  owner        User?         @relation(fields: [ownerId], references: [id])
  claimedStatus ClaimedStatus

  // ── NFC tag custody ───────────────────────────────────────────────────────
  /// Physical tag UID. Unique platform-wide — two SKUs can never claim the
  /// same tag, which is the primary defence against cloned tags.
  tagId                 String?           @unique
  /// Vendor provisioning batch reference. Not a foreign key: batches are
  /// recorded by the supply module and tags may arrive before that row exists.
  provisioningBatchId   String?
  tagLifecycleState     TagLifecycleState
  vendorId              String?           @db.Uuid
  vendor                Vendor?           @relation(fields: [vendorId], references: [id])
  vendorAuthenticatedAt DateTime?

  // ── One-shot claim token ──────────────────────────────────────────────────
  /// Single-use token minted on tap and burned on claim. Unique so a token can
  /// never be replayed against a second SKU.
  claimToken         String?   @unique
  claimTokenIssuedAt DateTime?
  claimTokenUsedAt   DateTime?

  // ── Trust / anti-fraud state ──────────────────────────────────────────────
  resaleBlocked       Boolean
  resaleBlockedReason String?
  /// Monotonic NFC tap counter — a counter that goes backwards indicates a
  /// replayed or cloned tag.
  lastTapCounter      Int
  tamperStatus        String?

  isActive   Boolean
  archivedAt DateTime?
  createdAt  DateTime
  updatedAt  DateTime

  // ── Cross-module back-relations ───────────────────────────────────────────
  productClaims         ProductClaim[]
  blockchainLedgers     BlockchainLedger[]
  buyerCollections      BuyerCollection[]
  productHistorys       ProductHistory[]
  contentUnlocks        ContentUnlock[]
  evolutionEvents       EvolutionEvent[]
  orders                Order[]
  inventoryReservations InventoryReservation[]
  resaleListings        ResaleListing[]
  supportCases          SupportCase[]

  @@unique([productId, serialNumber])
}

/// Whether the item has been claimed by an owner. IN_TRANSFER blocks
/// concurrent claims while ownership is moving; FLAGGED freezes the item
/// pending a support/fraud investigation.
enum ClaimedStatus {
  UNCLAIMED
  CLAIMED
  IN_TRANSFER
  FLAGGED
}

/// Custody state of the physical NFC tag, from manufacture to retirement.
/// UNPROVISIONED → BOUND (written to a SKU) → ACTIVE (claimed & in use);
/// LOST / REVOKED / DISPUTED are terminal states that block claims.
enum TagLifecycleState {
  UNPROVISIONED
  BOUND
  ACTIVE
  LOST
  REVOKED
  DISPUTED
}

// ───── source: packages\social\prisma\social.prisma ────────────────────────────────

// ============================================================================
// SOCIAL MODULE SCHEMA  (packages/social/prisma/social.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Follow, WishlistItem
//
// Buyer intent signals. Both tables feed the discover/marketplace read-side
// feeds and the notification triggers ("a drop you wishlisted is live").
// ============================================================================

/// A follow edge. Polymorphic by nullable target: exactly one of `artistId` or
/// `followedOrganizationId` is set. The two partial uniques prevent duplicate
/// follows of the same target while still allowing many rows per follower —
/// Postgres treats NULLs as distinct, so a row with a null target column never
/// collides on that key. `followedOrganizationId` is kept FK-free so the
/// organizations module can be extracted without touching this table.
model Follow {
  id                     String   @id @db.Uuid
  followerId             String   @db.Uuid
  follower               User     @relation(fields: [followerId], references: [id])
  artistId               String?  @db.Uuid
  artist                 Artist?  @relation(fields: [artistId], references: [id])
  followedOrganizationId String?  @db.Uuid
  createdAt              DateTime

  @@unique([followerId, artistId])
  @@unique([followerId, followedOrganizationId])
}

/// A saved product, optionally narrowed to a variant. Unique per
/// (user, product, variant). `notifyOnAvailable` is the hook the notifications
/// module reads when a drop opens or restocks.
model WishlistItem {
  id                String          @id @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id])
  productId         String          @db.Uuid
  product           Product         @relation(fields: [productId], references: [id])
  variantId         String?         @db.Uuid
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  notifyOnAvailable Boolean
  note              String?
  createdAt         DateTime

  @@unique([userId, productId, variantId])
}

// ───── source: packages\supply\prisma\supply.prisma ────────────────────────────────

// ============================================================================
// SUPPLY MODULE SCHEMA  (packages/supply/prisma/supply.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Vendor, SupplyBatch
//
// The physical side: who manufactures tags and merchandise, and what arrived.
// This is the upstream of the skus module — a Sku's `vendorId` and
// `provisioningBatchId` trace an item back to the shipment it came from.
// ============================================================================

/// A manufacturer or supplier.
model Vendor {
  id           String     @id @db.Uuid
  name         String
  vendorType   VendorType
  contactEmail String?
  isActive     Boolean
  archivedAt   DateTime?
  createdAt    DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  supplyBatchs SupplyBatch[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  skus Sku[]
}

/// A received shipment of tags or merchandise. `sourceFileRef` points at the
/// uploaded manifest (a media asset) that the batch was entered from, and
/// `enteredBy` records who keyed it in — together they make a physical
/// reconciliation auditable. `batchRef` is the vendor's own batch label, which
/// is what Sku.provisioningBatchId matches against.
model SupplyBatch {
  id            String         @id @db.Uuid
  vendorId      String         @db.Uuid
  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  itemType      SupplyItemType
  quantity      Int
  batchRef      String?
  receivedAt    DateTime
  sourceFileRef String?
  enteredById   String         @db.Uuid
  enteredBy     User           @relation(fields: [enteredById], references: [id])
  notes         String?
  createdAt     DateTime
}

/// What kind of supplier this is.
enum VendorType {
  NFC_TAG_MANUFACTURER
  MERCHANDISE_MANUFACTURER
  OTHER
}

/// What a supply batch contains.
enum SupplyItemType {
  NFC_TAG
  MERCHANDISE
}

