/// A creator's public identity. Optionally linked to a platform User (a
/// claimed, self-managed artist profile) and/or to an Organization (a brand
/// that manages the artist). Both are nullable so an artist can be catalogued
/// before either link exists.
model Artist {
  id                   String        @id @db.Uuid
  name                 String
  slug                 String        @unique
  bio                  String?
  avatarUrl            String?
  coverUrl             String?
  genre                String?
  isPublic             Boolean
  organizationId       String?       @db.Uuid
  organization         Organization? @relation(fields: [organizationId], references: [id])
  /// Unique — one User can back at most one Artist profile.
  userId               String?       @unique @db.Uuid
  user                 User?         @relation(fields: [userId], references: [id])
  /// The staff invitation this profile was created from, if any.
  ///
  /// An artist is invited before they have an account, so the profile is
  /// created with `userId` null and this id is the only thing connecting it to
  /// the person who was invited. When they accept, `userId` is filled in by
  /// matching on this. Unique, so replaying the invitation event cannot
  /// produce a second profile.
  ///
  /// Deliberately NOT a foreign key: StaffInvitation belongs to the
  /// access-control module, and a profile must survive that row being swept
  /// once the invitation has expired. Same reasoning as
  /// `Sku.provisioningBatchId`.
  invitationId         String?       @unique @db.Uuid
  complianceAttestedAt DateTime?
  /// User id of the staff member who attested compliance. Intentionally NOT a
  /// foreign key — an attestation must survive that account being removed.
  complianceAttestedBy String?       @db.Uuid
  isActive             Boolean
  archivedAt           DateTime?
  createdAt            DateTime
  updatedAt            DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  artistCollections ArtistCollection[]
  artistBrandLinks  ArtistBrandLink[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  products      Product[]
  productClaims ProductClaim[]
  mediaAssets   MediaAsset[]
  royaltyRules  RoyaltyRule[]
  follows       Follow[]
  /// Royalties owed TO this artist, and the batches that paid them. Named
  /// relation on the entries because an artist is both a rule scope and a
  /// payee, and Prisma needs the two links disambiguated.
  royaltyLedgerEntrys RoyaltyLedgerEntry[] @relation("RoyaltyLedgerEntry_payeeArtist")
  royaltyPayouts      RoyaltyPayout[]
  /// W-9 / PAN / GST registration and the information returns issued to this
  /// artist — see packages/tax.
  artistTaxDocuments  ArtistTaxDocument[]
  taxReturnFilings    TaxReturnFiling[]
}

/// A curated series of products by one artist — the unit buyers try to
/// complete. `position` orders collections on the artist's page.
model ArtistCollection {
  id             String        @id @db.Uuid
  name           String
  slug           String        @unique
  description    String?
  heroImageUrl   String?
  position       Int
  artistId       String        @db.Uuid
  artist         Artist        @relation(fields: [artistId], references: [id])
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isPublic       Boolean
  isActive       Boolean
  archivedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  // ── Cross-module back-relations ───────────────────────────────────────────
  products       Product[]
  productClaims  ProductClaim[]
  mediaAssets    MediaAsset[]
  contentBundles ContentBundle[]
  evolutionRules EvolutionRule[]
  royaltyRules   RoyaltyRule[]
}

/// A time-bounded commercial relationship between an artist and a brand.
/// The composite unique lets the same pair hold several link types at once
/// (e.g. PRIMARY plus MERCHANDISE) but never duplicate one.
model ArtistBrandLink {
  id             String              @id @db.Uuid
  artistId       String              @db.Uuid
  artist         Artist              @relation(fields: [artistId], references: [id])
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id])
  linkType       ArtistBrandLinkType
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean
  createdAt      DateTime

  @@unique([artistId, organizationId, linkType])
}

/// What an artist ↔ brand link covers.
enum ArtistBrandLinkType {
  PRIMARY
  MERCHANDISE
  DISTRIBUTION
}

