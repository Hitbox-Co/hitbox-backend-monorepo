/// Platform account. Identity (credentials, sessions) lives in Clerk — this
/// row is the local projection, created/updated via auth module events.
model User {
    id           String    @id @default(cuid())
    clerkUserId  String    @unique @map("clerk_user_id")
    email        String    @unique @db.VarChar(255)
    username     String?   @unique @db.VarChar(50)
    firstName    String?   @map("first_name") @db.VarChar(100)
    lastName     String?   @map("last_name") @db.VarChar(100)
    avatarUrl    String?   @map("avatar_url")
    // Verification status of the primary email, mirrored from Clerk on sync.
    // requireAuth blocks protected routes when false. Defaults true so rows
    // created before this column stay usable; the sync path writes the real value.
    emailVerified Boolean  @default(true) @map("email_verified")
    /// DEPRECATED — superseded by the authz module (UserRoleAssignment -> Role).
    /// Authorization NEVER reads this column; it is kept only so the column can
    /// be dropped in a later, separate migration once no deployed build reads it.
    /// See docs/authorization/12-operations.md ("retiring User.role").
    role         UserRole  @default(USER)
    state        UserState @default(ACTIVE)
    rewardPoints Int       @default(0) @map("reward_points")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")
    deletedAt    DateTime? @map("deleted_at") // soft delete — set when Clerk sends user.deleted

    products         Product[]
    productHistory   ProductHistory[]
    claims           ProductClaim[]
    buyerCollections BuyerCollection[]
    // Ledger rows where this user is the outgoing / incoming owner (transfers).
    ledgerFrom       BlockchainLedger[] @relation("LedgerFromUser")
    ledgerTo         BlockchainLedger[] @relation("LedgerToUser")

    // Authorization (owned by the authz module) — roles this user holds, the
    // grants they handed out, their tenant memberships and their audit trail.
    roleAssignments        UserRoleAssignment[]
    grantedRoleAssignments UserRoleAssignment[]     @relation("RoleGrantedBy")
    orgMemberships         OrganizationMembership[]
    auditLogs              AuditLog[]

    @@index([state])
    @@map("users")
}

