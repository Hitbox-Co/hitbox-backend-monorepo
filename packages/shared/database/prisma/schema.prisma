/// Scope narrows a capability to the set of rows it may touch.
/// Ordering is meaningful: OWN < ORGANIZATION < ANY (see PERMISSION_SCOPE_RANK).
enum PermissionScope {
    /// Only rows the acting user owns (resource.ownerId == user.id).
    OWN
    /// Only rows belonging to the organization the request is acting in.
    ORGANIZATION
    /// Any row on the platform, regardless of owner or tenant.
    ANY
}

/// Where a role may be assigned. Enforced at assignment time, not by convention:
/// PLATFORM roles are granted with organizationId = null, ORGANIZATION roles
/// always require one.
enum RoleKind {
    PLATFORM
    ORGANIZATION
}

enum OrganizationStatus {
    ACTIVE
    SUSPENDED
}

enum MembershipStatus {
    ACTIVE
    INVITED
    SUSPENDED
}

/// Outcome recorded on an audit row. DENIED is kept distinct from FAILURE so
/// authorization refusals can be alerted on separately from crashes.
enum AuditResult {
    SUCCESS
    FAILURE
