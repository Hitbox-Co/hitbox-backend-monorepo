// ============================================================================
// RELEASES MODULE SCHEMA  (packages/releases/prisma/releases.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: ReleaseApproval
//
// The review workflow that gates Product.status. Separated from products
// because it is a different actor's surface (HitBox reviewer / compliance)
// with its own audit expectations.
// ============================================================================

/// One approval decision on one version of a drop. `version` increments each
/// time the drop is resubmitted, so the full review history is preserved rather
/// than overwritten. The compliance fields are the reviewer's sign-off and are
/// mirrored onto Product.complianceStatus once decided.
model ReleaseApproval {
  id                String           @id @db.Uuid
  productId         String           @db.Uuid
  product           Product          @relation(fields: [productId], references: [id])
  approverId        String           @db.Uuid
  approver          User             @relation("User_approver", fields: [approverId], references: [id])
  status            ApprovalStatus
  comment           String?
  version           Int
  decidedAt         DateTime?
  complianceStatus  ComplianceStatus
  oddsDisclosureRef String?
  checkedById       String?          @db.Uuid
  checkedBy         User?            @relation("User_checkedBy", fields: [checkedById], references: [id])
  checkedAt         DateTime?
  createdAt         DateTime
  updatedAt         DateTime
}

/// Outcome of a release review.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───── source: packages\resale\prisma\resale.prisma ────────────────────────────────

// ============================================================================
// RESALE MODULE SCHEMA  (packages/resale/prisma/resale.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: ResaleListing
//
// The secondary market. Distinct from the `marketplace` package, which is a
// read-side feed over the primary catalog and owns no tables.
// ============================================================================

/// A holder's offer to sell a SKU they own. BLOCKED is set when the SKU carries
/// `resaleBlocked` (fraud hold, artist restriction) — the listing is kept
/// rather than deleted so the seller can see why it stopped. A resale that
/// completes writes a TRANSFER onto the SKU's provenance chain in the claims
/// module; nothing about ownership is decided here.
model ResaleListing {
  id        String       @id @db.Uuid
  sellerId  String       @db.Uuid
  seller    User         @relation(fields: [sellerId], references: [id])
  skuId     String       @db.Uuid
  sku       Sku          @relation(fields: [skuId], references: [id])
  price     Decimal      @db.Decimal(12, 2)
  currency  Currency
  status    ResaleStatus
  createdAt DateTime
  updatedAt DateTime
}

/// Listing state. BLOCKED is platform-imposed; CANCELLED is seller-initiated.
enum ResaleStatus {
  ACTIVE
  SOLD
  CANCELLED
  BLOCKED
}

// ───── source: packages\search\prisma\search.prisma ────────────────────────────────

// ============================================================================
// SEARCH MODULE SCHEMA  (packages/search/prisma/search.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: SearchIndexJob
// ============================================================================

/// Outbox row for the search indexer. Writers enqueue a job in the same
/// transaction as the data change, so an index update can never be lost even
/// if the indexer is down. `entityType` + `entityId` are a deliberately
/// FK-free polymorphic pointer — the indexer covers products, artists,
/// collections and organizations, and must not couple to any of their tables.
/// `entityId` is null for a FULL_REINDEX. `attempts` + `lastError` drive
/// bounded retry with a dead-letter threshold.
model SearchIndexJob {
  id          String         @id @db.Uuid
  entityType  String
  entityId    String?        @db.Uuid
  operation   IndexOperation
  status      IndexJobStatus
  attempts    Int
  lastError   String?
  createdAt   DateTime
  completedAt DateTime?
}

/// What the indexer should do with the entity.
enum IndexOperation {
  UPSERT
  DELETE
  FULL_REINDEX
}

/// Job state. RUNNING rows left behind by a crashed worker are requeued by age.
enum IndexJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

