// ============================================================================
// SOURCE PARTIAL — shared enums. Owned by shared/database.
//
// OWNERSHIP RULE: an enum lives here ONLY if two or more module partials
// reference it. An enum used by a single module belongs in that module's own
// partial, so the module carries it along when it is extracted into a service.
// See docs/database-architecture.md §5.
// ============================================================================

/// Public/private toggle. Used by users (User.profileVisibility) and
/// collections (BuyerCollection.visibility).
enum Visibility {
    PUBLIC
    PRIVATE
}

/// Settlement currency. Used by markets, orders, payments, finance, resale and
/// claims (ProductHistory.price). Every monetary column pairs an amount with
/// one of these.
enum Currency {
    USD
    INR
    GBP
}

/// Regulatory clearance state. Used by products (Product.complianceStatus) and
/// releases (ReleaseApproval.complianceStatus) — the release reviewer writes
/// it, the catalog reflects it.
enum ComplianceStatus {
    PENDING
    CLEARED
    FLAGGED
}

/// Address nickname. Used by users (Address) and orders (OrderAddress), which
/// snapshots the label alongside the address lines at purchase time.
enum AddressLabel {
    HOME
    WORK
    OTHER
}

/// Payment provider. Used by orders (Order.gateway) and payments
/// (PaymentTransaction, PaymentGatewayConfig, PaymentWebhookEvent).
enum PaymentGateway {
    STRIPE
}
