// ============================================================================
// PRODUCTS MODULE SCHEMA  (packages/products/prisma/products.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Drop, DropVariant, DropImage, DropPrice,
//       DropType, DropTypeDimension, DropTypeDimensionValue, DropVariantOption
//
// Drop types drive variants: a type declares which dimensions a variant varies
// along (size, color, edition…), which values each may take, and the rules
// between them. See docs/admin/drop-types-and-variants.md.
//
// This module is the CATALOG — the definition of what is for sale. The
// serialized physical items are the skus module (Sku); the two are deliberately
// separate so catalog editing and item/tag custody can scale apart.
//
// NAMING (v3.1): these models were called Product / ProductVariant /
// ProductImage / ProductPrice. "Drop" is what the business calls this record
// everywhere else, and the old name kept reading as "a physical thing", which
// is the Sku.
//
// The rename initially landed as a Prisma-only rename behind @@map, keeping the
// physical names. v3.1.1 renamed the tables themselves (ALTER TABLE ... RENAME,
// metadata-only, no data copied), so there is no @@map here any more and every
// Prisma name is the database name. Anything reading these tables by their old
// name — raw SQL, a BI tool, a dashboard query — has to be updated with it.
// ============================================================================

/// A drop: one sellable product definition. `totalSupply` is the number of
/// serialized SKUs that will exist. `status` drives the release workflow
/// (DRAFT → SUBMITTED → IN_REVIEW → APPROVED → PUBLISHED → ACTIVE → ENDED),
/// with the decisions themselves recorded in the releases module.
model Drop {
  id                String            @id @db.Uuid
  /// Human-readable record id (`drp…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  groupCode         String            @unique
  name              String
  description       String?
  collectionId      String?           @db.Uuid
  collection        ArtistCollection? @relation(fields: [collectionId], references: [id])
  artistId          String?           @db.Uuid
  artist            Artist?           @relation(fields: [artistId], references: [id])
  organizationId    String?           @db.Uuid
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  /// What kind of product this is. Null = a legacy drop created before drop
  /// types existed: no variant rules apply to it.
  dropTypeId        String?           @db.Uuid
  dropType          DropType?         @relation(fields: [dropTypeId], references: [id])
  /// The DropType.version this drop's variants were last validated against.
  dropTypeVersion   Int?
  vertical          String?
  category          String?
  rarity            String?
  /// Max units one buyer may purchase; null = unlimited.
  purchaseLimit     Int?
  totalSupply       Int
  releaseStart      DateTime?
  releaseEnd        DateTime?
  status            DropStatus
  /// When the drop becomes visible. Distinct from `publishedAt`, which records
  /// when it actually was: this is the scheduled intent, set ahead of time.
  publishAt         DateTime?
  publishedAt       DateTime?
  complianceStatus  ComplianceStatus
  /// Pointer to the published odds disclosure (required for randomised drops).
  oddsDisclosureRef String?
  isAgeSpecific     Boolean
  minimumAge        Int?
  isActive          Boolean
  archivedAt        DateTime?
  createdAt         DateTime
  updatedAt         DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  dropImages   DropImage[]
  dropVariants DropVariant[]
  dropPrices   DropPrice[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  skus             Sku[]
  skuClaims        SkuClaim[]
  releaseApprovals ReleaseApproval[]
  mediaAssets      MediaAsset[]
  contentBundles   ContentBundle[]
  evolutionRules   EvolutionRule[]
  orders           Order[]
  royaltyRules     RoyaltyRule[]
  wishlistItems    WishlistItem[]
  /// Per-product GST/sales-tax rates and HSN codes — see packages/tax.
  taxConfigurations TaxConfiguration[]
  /// Monthly COGS variance reviews for this drop — see packages/finance.
  cogsReconciliations CogsReconciliation[]
  /// Vendor consignments received against this drop — see packages/supply.
  supplyBatches       SupplyBatch[]
}

/// A purchasable option of a drop — "M / Black", "Pack of 5", "A3 Limited".
///
/// The options themselves live in DropVariantOption, one row per dimension.
/// `optionName` / `optionValue` are kept for existing readers: for a typed
/// variant they hold the dimension codes and value codes joined by "/"
/// ("size/color", "M/BLK"); legacy rows keep their original single pair.
model DropVariant {
  id          String    @id @db.Uuid
  /// Human-readable record id (`dvr…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  /// Kept as `productId` rather than renamed to `dropId`: the rename this
  /// release asks for is of *models* and *relation fields*, and renaming this
  /// scalar too would churn the compound key `productId_optionName_optionValue`
  /// through every call site for no behavioural gain. DropPrice is the one
  /// exception, because its unique key is being changed anyway.
  productId   String    @db.Uuid
  drop        Drop      @relation(fields: [productId], references: [id])
  variantCode String    @unique
  label       String
  optionName  String
  optionValue String
  /// Canonical, sorted "color=BLK|size=M" — the database-level guard against
  /// the same combination twice on one drop. Built by the service, never sent
  /// by a client. Legacy rows hold "legacy:<optionName>=<optionValue>".
  optionsKey  String
  position    Int
  /// Per-variant supply cap; null = drawn from the drop's totalSupply.
  totalSupply Int?
  isActive    Boolean
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  dropPrices DropPrice[]
  options    DropVariantOption[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  skus          Sku[]
  orders        Order[]
  wishlistItems WishlistItem[]

  @@unique([productId, optionName, optionValue])
  @@unique([productId, optionsKey])
}

/// One dimension value of one variant. "M / Black" is two rows.
///
/// Labels and the hex code are SNAPSHOTS taken when the variant was created:
/// renaming "Black" to "Jet Black" on the type must not rewrite what an
/// existing order or invoice says was bought.
model DropVariantOption {
  id             String      @id @db.Uuid
  /// Human-readable record id (`dvo…`). Written by the publicCode extension.
  publicCode     String?     @unique @db.VarChar(32)
  variantId      String      @db.Uuid
  variant        DropVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  dimensionCode  String
  dimensionLabel String
  valueCode      String
  valueLabel     String
  /// "#RRGGBB" for a COLOR dimension, so a swatch renders without a lookup.
  hexCode        String?     @db.VarChar(7)
  position       Int
  createdAt      DateTime

  @@unique([variantId, dimensionCode])
  @@index([dimensionCode, valueCode])
}

/// What kind of product a drop is — T-shirt, card, poster — and the variant
/// rules that follow from it. Configuration, not code: a new product type is a
/// new row, with no change to the Drop, variant or SKU APIs.
model DropType {
  id                 String      @id @db.Uuid
  /// Human-readable record id (`dty…`). Written by the publicCode extension.
  publicCode         String?     @unique @db.VarChar(32)
  /// Stable machine key — `T_SHIRT`. Never changes once drops use it.
  code               String      @unique
  name               String
  description        String?
  variantMode        VariantMode
  /// Tokens: {groupCode}, {values}. Must contain both.
  variantCodePattern String      @default("{groupCode}-{values}")
  /// Cross-dimension rules (require / forbid / exclude), zod-validated on
  /// write. See packages/products/src/drop-type/rules.ts.
  rules              Json        @default("[]")
  /// Bumped on every change to dimensions, values or rules.
  version            Int         @default(1)
  isActive           Boolean     @default(true)
  createdAt          DateTime
  updatedAt          DateTime

  dimensions DropTypeDimension[]
  drops      Drop[]
}

/// One axis a variant varies along — size, color, edition.
model DropTypeDimension {
  id                String               @id @db.Uuid
  /// Human-readable record id (`dtd…`). Written by the publicCode extension.
  publicCode        String?              @unique @db.VarChar(32)
  dropTypeId        String               @db.Uuid
  dropType          DropType             @relation(fields: [dropTypeId], references: [id])
  /// Machine key — `size`. Used in DropVariant.optionsKey.
  code              String
  label             String
  position          Int
  required          Boolean
  /// The admin may enter a value not in the list for one drop.
  allowCustomValues Boolean              @default(false)
  /// How a screen should render the values. COLOR values may carry a hex code.
  displayType       DimensionDisplayType @default(TEXT)
  archivedAt        DateTime?
  createdAt         DateTime
  updatedAt         DateTime

  values DropTypeDimensionValue[]

  @@unique([dropTypeId, code])
}

/// One allowed value of a dimension — "M", "Black", "Pack".
model DropTypeDimensionValue {
  id          String            @id @db.Uuid
  /// Human-readable record id (`dtv…`). Written by the publicCode extension.
  publicCode  String?           @unique @db.VarChar(32)
  dimensionId String            @db.Uuid
  dimension   DropTypeDimension @relation(fields: [dimensionId], references: [id])
  /// Short uppercase code used in variantCode — `BLK`. [A-Z0-9], 1–12 chars.
  code        String
  label       String
  /// "#RRGGBB". Only on a COLOR dimension; optional even there.
  hexCode     String?           @db.VarChar(7)
  position    Int
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([dimensionId, code])
}

/// Joins a drop to a media asset for gallery display. The asset itself is
/// owned by the media module; this row only carries the placement (position,
/// primary flag, alt text).
model DropImage {
  id         String     @id @db.Uuid
  /// Human-readable record id (`dim…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  /// See the note on DropVariant.productId.
  productId  String     @db.Uuid
  drop       Drop       @relation(fields: [productId], references: [id])
  assetId    String     @db.Uuid
  asset      MediaAsset @relation(fields: [assetId], references: [id])
  position   Int
  isPrimary  Boolean
  altText    String?
  archivedAt DateTime?
  createdAt  DateTime

  @@unique([productId, assetId])
}

/// Price of a drop (optionally a specific variant) in one market.
/// `costOfGoods` is stored here so the finance ledger can compute margin
/// without re-deriving it.
///
/// Prices are **versioned** rather than mutable: `effectiveFrom` /
/// `effectiveTo` bound the window a row is in force for, and the composite
/// unique includes `effectiveFrom` so the same drop/variant/market triple can
/// hold its whole price history. The invariant that used to be enforced by the
/// three-column unique — one active price per triple — is now a query
/// condition (`effectiveFrom <= now AND (effectiveTo IS NULL OR effectiveTo >
/// now)`), because a unique index cannot express "at most one *open* row".
model DropPrice {
  id            String          @id @db.Uuid
  /// Human-readable record id (`dpr…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  dropId        String          @db.Uuid
  drop          Drop            @relation(fields: [dropId], references: [id])
  variantId     String?         @db.Uuid
  variant       DropVariant?    @relation(fields: [variantId], references: [id])
  marketId      String          @db.Uuid
  market        Market          @relation(fields: [marketId], references: [id])
  amount        Decimal?        @db.Decimal(12, 2)
  isFree        Boolean
  costOfGoods   Decimal?        @db.Decimal(12, 2)
  status        DropPriceStatus
  /// Start of this price point's window. Defaults to now so an insert that
  /// does not care about versioning behaves exactly as it did before.
  effectiveFrom DateTime        @default(now())
  /// Null while the price is current; set when a newer row supersedes it.
  effectiveTo   DateTime?
  /// Approver's user id. No foreign key — a price record must outlive the
  /// account that signed it off, same rule as RoyaltyPayout.approvedById.
  approvedById  String?         @db.Uuid
  approvedAt    DateTime?
  createdAt     DateTime
  updatedAt     DateTime

  @@unique([dropId, variantId, marketId, effectiveFrom])
}

/// Lifecycle state of a drop. APPROVED means cleared for release; PUBLISHED
/// means visible; ACTIVE means inside its release window and buyable.
enum DropStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ACTIVE
  ENDED
  ARCHIVED
}

/// Whether a drop of a type has variants at all.
enum VariantMode {
  /// No variants — the drop itself is the one sellable item (a keychain).
  NONE
  /// Variants allowed but not needed.
  OPTIONAL
  /// At least one active variant before the drop can be submitted for review,
  /// and every minted unit must belong to one.
  REQUIRED
}

/// How a dimension's values are shown.
enum DimensionDisplayType {
  TEXT
  /// Rendered as swatches; values may carry `hexCode`.
  COLOR
}

/// Whether a price point is currently in effect.
enum DropPriceStatus {
  ACTIVE
  DISABLED
}
