// ============================================================================
// PRODUCTS MODULE SCHEMA  (packages/products/prisma/products.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Product, ProductVariant, ProductImage, ProductPrice
//
// This module is the CATALOG — the definition of what is for sale. The
// serialized physical items are the skus module (Sku); the two are deliberately
// separate so catalog editing and item/tag custody can scale apart.
// ============================================================================

/// A drop: one sellable product definition. `totalSupply` is the number of
/// serialized SKUs that will exist. `status` drives the release workflow
/// (DRAFT → SUBMITTED → IN_REVIEW → APPROVED → PUBLISHED → ACTIVE → ENDED),
/// with the decisions themselves recorded in the releases module.
model Product {
  id                String            @id @db.Uuid
  groupCode         String            @unique
  name              String
  description       String?
  collectionId      String?           @db.Uuid
  collection        ArtistCollection? @relation(fields: [collectionId], references: [id])
  artistId          String?           @db.Uuid
  artist            Artist?           @relation(fields: [artistId], references: [id])
  organizationId    String?           @db.Uuid
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  vertical          String?
  category          String?
  rarity            String?
  /// Max units one buyer may purchase; null = unlimited.
  purchaseLimit     Int?
  totalSupply       Int
  releaseStart      DateTime?
  releaseEnd        DateTime?
  status            DropStatus
  publishedAt       DateTime?
  complianceStatus  ComplianceStatus
  /// Pointer to the published odds disclosure (required for randomised drops).
  oddsDisclosureRef String?
  isAgeSpecific     Boolean
  minimumAge        Int?
  isActive          Boolean
  archivedAt        DateTime?
  createdAt         DateTime
  updatedAt         DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  productImages   ProductImage[]
  productVariants ProductVariant[]
  productPrices   ProductPrice[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  skus             Sku[]
  productClaims    ProductClaim[]
  releaseApprovals ReleaseApproval[]
  mediaAssets      MediaAsset[]
  contentBundles   ContentBundle[]
  evolutionRules   EvolutionRule[]
  orders           Order[]
  royaltyRules     RoyaltyRule[]
  wishlistItems    WishlistItem[]
}

/// A purchasable option of a product — size, colourway, edition. Modelled as a
/// single name/value pair per row, with the composite unique preventing the
/// same option value twice on one product.
model ProductVariant {
  id          String    @id @db.Uuid
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  variantCode String    @unique
  label       String
  optionName  String
  optionValue String
  position    Int
  /// Per-variant supply cap; null = drawn from the product's totalSupply.
  totalSupply Int?
  isActive    Boolean
  archivedAt  DateTime?
  createdAt   DateTime
  updatedAt   DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  productPrices ProductPrice[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  skus          Sku[]
  orders        Order[]
  wishlistItems WishlistItem[]

  @@unique([productId, optionName, optionValue])
}

/// Joins a product to a media asset for gallery display. The asset itself is
/// owned by the media module; this row only carries the placement (position,
/// primary flag, alt text).
model ProductImage {
  id         String     @id @db.Uuid
  productId  String     @db.Uuid
  product    Product    @relation(fields: [productId], references: [id])
  assetId    String     @db.Uuid
  asset      MediaAsset @relation(fields: [assetId], references: [id])
  position   Int
  isPrimary  Boolean
  altText    String?
  archivedAt DateTime?
  createdAt  DateTime

  @@unique([productId, assetId])
}

/// Price of a product (optionally a specific variant) in one market. The
/// composite unique guarantees a single active price point per
/// product/variant/market triple. `costOfGoods` is stored here so the finance
/// ledger can compute margin without re-deriving it.
model ProductPrice {
  id          String             @id @db.Uuid
  productId   String             @db.Uuid
  product     Product            @relation(fields: [productId], references: [id])
  variantId   String?            @db.Uuid
  variant     ProductVariant?    @relation(fields: [variantId], references: [id])
  marketId    String             @db.Uuid
  market      Market             @relation(fields: [marketId], references: [id])
  amount      Decimal?           @db.Decimal(12, 2)
  isFree      Boolean
  costOfGoods Decimal?           @db.Decimal(12, 2)
  status      ProductPriceStatus
  createdAt   DateTime
  updatedAt   DateTime

  @@unique([productId, variantId, marketId])
}

/// Lifecycle state of a drop. APPROVED means cleared for release; PUBLISHED
/// means visible; ACTIVE means inside its release window and buyable.
enum DropStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ACTIVE
  ENDED
  ARCHIVED
}

/// Whether a price point is currently in effect.
enum ProductPriceStatus {
  ACTIVE
  DISABLED
}
