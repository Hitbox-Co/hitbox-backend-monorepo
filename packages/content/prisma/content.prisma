// ============================================================================
// CONTENT MODULE SCHEMA  (packages/content/prisma/content.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: ContentBundle, ContentBundleItem, ContentBundleSerial, ContentUnlock
//
// The reward layer: exclusive content attached to a drop or collection, and
// the per-user grants that open it. Files themselves belong to the media
// module — a bundle is only a curated list plus an access policy.
// ============================================================================

/// A named set of exclusive assets, attached to a product or a collection
/// (both nullable — a bundle can hang off either). `accessType` states how it
/// is earned rather than who has it; the grants are ContentUnlock rows.
model ContentBundle {
  id           String            @id @db.Uuid
  /// Human-readable record id (`cbd…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  name         String
  description  String?
  productId    String?           @db.Uuid
  drop         Drop?             @relation(fields: [productId], references: [id])
  collectionId String?           @db.Uuid
  collection   ArtistCollection? @relation(fields: [collectionId], references: [id])
  accessType   ContentAccessType
  isActive     Boolean
  archivedAt   DateTime?
  createdAt    DateTime
  updatedAt    DateTime

  // ── Moderation (HitBox staff) ─────────────────────────────────────────────
  /// Set when HitBox switched the reward off or removed it. While set, the
  /// artist cannot switch it back on or restore it — only staff can lift it.
  /// docs/content/admin-rewards-api.md.
  moderationLockedAt DateTime?
  /// Why — shown to the artist.
  moderationReason   String?   @db.VarChar(500)
  /// The staff member's user id. Not a foreign key: the record outlives the account.
  moderatedById      String?   @db.Uuid

  // ── Own-module back-relations ─────────────────────────────────────────────
  contentBundleItems ContentBundleItem[]
  contentUnlocks     ContentUnlock[]
  /// SKU_EXCLUSIVE only: which units of the drop open it.
  eligibleSerials    ContentBundleSerial[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  evolutionRules EvolutionRule[]
}

/// Places one media asset in one bundle at a position. Unique per
/// (bundle, asset) so an asset cannot be listed twice in the same bundle.
model ContentBundleItem {
  id       String        @id @db.Uuid
  /// Human-readable record id (`cbi…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  bundleId String        @db.Uuid
  bundle   ContentBundle @relation(fields: [bundleId], references: [id])
  assetId  String        @db.Uuid
  asset    MediaAsset    @relation(fields: [assetId], references: [id])
  position Int
  /// Display title shown to the buyer ("Behind the scenes"). Optional — the
  /// file name is the fallback.
  title    String?       @db.VarChar(200)

  @@unique([bundleId, assetId])
}

/// A user's grant to one bundle, optionally tied to the specific SKU that
/// earned it (`skuId` in the unique key — owning two copies grants two rows).
/// `accessExpiresAt` supports time-limited drops; the notified/acknowledged/
/// lastAccessed/accessCount columns are engagement telemetry, not access
/// control.
model ContentUnlock {
  id              String        @id @db.Uuid
  /// Human-readable record id (`cul…`). Unique, never a foreign key —
  /// the uuid above stays the key. Written by the publicCode client extension.
  publicCode String? @unique @db.VarChar(32)
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id])
  bundleId        String        @db.Uuid
  bundle          ContentBundle @relation(fields: [bundleId], references: [id])
  skuId           String?       @db.Uuid
  sku             Sku?          @relation(fields: [skuId], references: [id])
  grantedAt       DateTime
  notifiedAt      DateTime?
  acknowledgedAt  DateTime?
  accessExpiresAt DateTime?
  lastAccessedAt  DateTime?
  accessCount     Int

  @@unique([userId, bundleId, skuId])
}

/// One unit of a drop that opens a SKU_EXCLUSIVE bundle, named by its serial
/// number ("#001 of 100") rather than by Sku id: the serial is the unit's
/// printed identity and exists before the Sku row is minted. Whoever owns
/// (has claimed) that unit now can open the bundle — access follows the item
/// on resale and ends with a revoked claim. docs/content/drop-content.md.
model ContentBundleSerial {
  bundleId     String        @db.Uuid
  bundle       ContentBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  serialNumber Int
  createdAt    DateTime      @default(now())

  @@id([bundleId, serialNumber])
}

/// How a bundle is earned: simply by owning the item (OWNER_ONLY — on a drop,
/// its regular content, for the owner of any unit), by owning one of the
/// specific units listed in ContentBundleSerial (SKU_EXCLUSIVE — a drop's
/// exclusive content; see docs/content/drop-content.md), by hitting an
/// evolution threshold (EVOLUTION_GRANT), by a campaign/reward
/// (REWARD_GRANT), or by collecting every released drop of an artist
/// collection (COLLECTION_COMPLETE — the artist's collection reward, one per
/// collection; see docs/content/collection-rewards.md).
enum ContentAccessType {
  OWNER_ONLY
  EVOLUTION_GRANT
  REWARD_GRANT
  COLLECTION_COMPLETE
  SKU_EXCLUSIVE
}
