// ============================================================================
// COLLECTIONS MODULE SCHEMA  (packages/collections/prisma/collections.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: BuyerCollection
//
// The buyer's shelf. Distinct from ArtistCollection (artist module), which is
// the curated series a buyer is trying to complete.
// ============================================================================

/// One item on a buyer's shelf. Unique per (user, sku), so an item appears
/// once. `shareToken` is a capability URL for showing a private shelf to
/// someone without making it PUBLIC — unique so tokens are unguessable and
/// individually revocable by nulling the column.
model BuyerCollection {
  id         String     @id @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id])
  skuId      String     @db.Uuid
  sku        Sku        @relation(fields: [skuId], references: [id])
  visibility Visibility
  shareToken String?    @unique
  acquiredAt DateTime
  archivedAt DateTime?

  @@unique([userId, skuId])
}
