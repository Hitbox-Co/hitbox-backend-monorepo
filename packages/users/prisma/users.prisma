/// Platform account. Identity (credentials, sessions) lives in Clerk — this
/// row is the local projection, created/updated via auth module events.
model User {
    id           String    @id @default(cuid())
    clerkUserId  String    @unique @map("clerk_user_id")
    email        String    @unique @db.VarChar(255)
    username     String?   @unique @db.VarChar(50)
    firstName    String?   @map("first_name") @db.VarChar(100)
    lastName     String?   @map("last_name") @db.VarChar(100)
    avatarUrl    String?   @map("avatar_url")
    // Verification status of the primary email, mirrored from Clerk on sync.
    // requireAuth blocks protected routes when false. Defaults true so rows
    // created before this column stay usable; the sync path writes the real value.
    emailVerified Boolean  @default(true) @map("email_verified")
    role         UserRole  @default(USER)
    state        UserState @default(ACTIVE)
    rewardPoints Int       @default(0) @map("reward_points")
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")
    deletedAt    DateTime? @map("deleted_at") // soft delete — set when Clerk sends user.deleted

    products         Product[]
    productHistory   ProductHistory[]
    claims           ProductClaim[]
    buyerCollections BuyerCollection[]
    // Ledger rows where this user is the outgoing / incoming owner (transfers).
    ledgerFrom       BlockchainLedger[] @relation("LedgerFromUser")
    ledgerTo         BlockchainLedger[] @relation("LedgerToUser")

    @@index([state])
    @@map("users")
}
