// ============================================================================
// CLAIMS MODULE SCHEMA  (packages/claims/prisma/claims.prisma)
// NFC claims + provenance ledger (ledger lives here: authenticity domain).
// Merged by shared/database/scripts/merge-schema.mjs.
// ============================================================================

/// NFC claim events: which user claimed which product, when.
model ProductClaim {
    id        String   @id @default(cuid())
    claimCode String   @unique @db.VarChar(10) // old hb_pc_claimid (CHAR(10))
    claimedNo Int      @default(1) @map("claimed_no")
    claimedAt DateTime @default(now()) @map("claimed_at")

    userId String @map("user_id")
    user   User   @relation(fields: [userId], references: [id])

    productId String  @map("product_id")
    product   Product @relation(fields: [productId], references: [id])

    artistId String? @map("artist_id")
    artist   Artist? @relation(fields: [artistId], references: [id])

    collectionId String?           @map("collection_id")
    collection   ArtistCollection? @relation(fields: [collectionId], references: [id])

    ledgerEntries BlockchainLedger[]

    @@index([userId])
    @@index([productId])
    @@map("product_claims")
}

/// Provenance ledger: origin data + cryptographic signatures + hash per
/// transaction. Append-only per product — rows form a chain ordered by
/// `sequenceNo`, each linking to the prior row's hash via `previousHash`.
/// The seq-0 MINT row's seller signature is HitBox.
model BlockchainLedger {
    id                     String       @id @default(cuid())
    txType                 LedgerTxType @default(MINT) @map("tx_type")
    // 0-based position in this product's chain. seq 0 = MINT (origin).
    sequenceNo             Int          @map("sequence_no")
    originDateTime         DateTime     @map("origin_date_time")
    originOwner            String       @map("origin_owner") @db.VarChar(255)
    sellerDigitalSignature String       @map("seller_digital_signature")
    buyerDigitalSignature  String?      @map("buyer_digital_signature")
    receiverPublicKey      String?      @map("receiver_public_key")
    productBuyerHash       String       @map("product_buyer_hash")
    // Hash of the immediately preceding chain row (null for seq 0). Tampering
    // with any earlier row breaks every subsequent link.
    previousHash           String?      @map("previous_hash")
    transactionDateTime    DateTime     @default(now()) @map("transaction_date_time")
    transactionAmount      Decimal      @default(0) @map("transaction_amount") @db.Decimal(12, 2)

    originProductId String  @map("origin_product_id")
    originProduct   Product @relation(fields: [originProductId], references: [id])

    claimId String?       @map("claim_id")
    claim   ProductClaim? @relation(fields: [claimId], references: [id])

    // Ownership delta captured by this row. `fromUser` is null on MINT/CLAIM
    // (origin is HitBox, not a local user); `toUser` is null only on MINT.
    fromUserId String? @map("from_user_id")
    fromUser   User?   @relation("LedgerFromUser", fields: [fromUserId], references: [id])

    toUserId String? @map("to_user_id")
    toUser   User?   @relation("LedgerToUser", fields: [toUserId], references: [id])

    @@unique([originProductId, sequenceNo])
    @@index([originProductId])
    @@index([claimId])
    @@map("blockchain_ledger")
}
