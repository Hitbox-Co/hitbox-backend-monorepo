// ============================================================================
// ACCESS-CONTROL MODULE SCHEMA  (packages/access-control/prisma/access-control.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Role, Permission, RolePermission, RoleAssignment
//
// This is authorisation (what an actor may do), distinct from the auth module
// which is authentication (who the actor is). A user's UserRole says only that
// they hold an account; every real privilege is a RoleAssignment here, scoped
// to GLOBAL, one ORG, or the actor's OWN records.
// ============================================================================

/// A named bundle of permissions, e.g. `HITBOX_CONTENT_MANAGER`.
/// `entityGroup` records which persona family the role belongs to (end_user,
/// brand_artist, hitbox_seller_org) for grouping in admin UIs.
///
/// `domain` is the security boundary: a BUSINESS role may hold only BUSINESS
/// permissions and a TECHNICAL role only TECHNICAL ones. The engine and the
/// role service both enforce it, so "platform engineer" can never quietly
/// acquire `order:refund`. A person who genuinely needs both holds two role
/// assignments.
///
/// `isSystem` marks roles seeded from the code-side catalog. They cannot be
/// renamed or deleted through the admin API — deleting HITBOX_SYSTEM_ADMIN
/// would lock everyone out of the platform.
model Role {
  id          String              @id @db.Uuid
  name        String              @unique
  displayName String
  entityGroup String
  domain      AuthorizationDomain
  isSystem    Boolean
  isActive    Boolean
  createdAt   DateTime

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]
}

/// One atomic capability: an action on a resource at a scope. The
/// `key` column is the flat form used in code checks (e.g. `drop:publish:org`);
/// the (resource, action, scope) triple is the canonical identity.
model Permission {
  id          String              @id @db.Uuid
  resource    ResourceType
  action      PermissionAction
  scope       PermissionScope
  key         String              @unique
  /// Which authorization domain this capability belongs to. Derived from the
  /// resource (see RESOURCE_DOMAIN in the permission catalog), never chosen
  /// per-row, so a resource cannot be business in one permission and
  /// technical in another.
  domain      AuthorizationDomain
  description String?
  isActive    Boolean
  createdAt   DateTime

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
}

/// Grants a permission to a role. `fieldAllowlist` narrows the grant to
/// specific columns (field-level authorisation for partial-update endpoints).
/// `isInferred` + `sourceCitation` mark rows derived from the requirements
/// matrix rather than hand-authored, so they can be re-derived safely.
model RolePermission {
  id             String     @id @db.Uuid
  roleId         String     @db.Uuid
  role           Role       @relation(fields: [roleId], references: [id])
  permissionId   String     @db.Uuid
  permission     Permission @relation(fields: [permissionId], references: [id])
  fieldAllowlist String[]
  isInferred     Boolean
  sourceCitation String?
  createdAt      DateTime

  @@unique([roleId, permissionId])
}

/// Binds a user to a role within a scope. For `scopeType = ORG`, `scopeId`
/// points at an Organization (the relation below); for OWN/GLOBAL it is null.
/// `revokedAt` is set instead of deleting the row, so the audit trail keeps
/// the full grant history.
model RoleAssignment {
  id           String        @id @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation("User_user", fields: [userId], references: [id])
  roleId       String        @db.Uuid
  role         Role          @relation(fields: [roleId], references: [id])
  scopeType    RoleScopeType
  scopeId      String?       @db.Uuid
  organization Organization? @relation(fields: [scopeId], references: [id])
  grantedById  String        @db.Uuid
  grantedBy    User          @relation("User_grantedBy", fields: [grantedById], references: [id])
  grantedAt    DateTime
  revokedAt    DateTime?

  @@unique([userId, roleId, scopeType, scopeId])
}

/// The verbs a permission can grant.
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  MANAGE // superset of CREATE+READ+UPDATE+DELETE for the resource
  APPROVE
  REJECT
  PUBLISH
  REFUND
  CLAIM // NFC tag / product claim
  TRANSFER // ownership transfer
  ASSIGN // assign roles / ownership
  EXPORT // reports & dashboards
  CONFIGURE // platform / gateway config
  OVERRIDE // admin override
  // ── Technical-domain verbs (APPLICATION / INFRASTRUCTURE resources) ──────
  DEBUG // read logs, traces, run diagnostics
  DEPLOY // ship a release / apply infrastructure
  RESTART // bounce a service or node
}

/// The protected surfaces a permission can apply to. Deliberately coarser than
/// the table list: one ResourceType may cover several tables owned by the same
/// module (e.g. ORDER covers Order + OrderAddress + InventoryReservation).
enum ResourceType {
  SELF_PROFILE
  BUYER_PROFILE
  DROP
  RELEASE_APPROVAL
  COLLECTIBLE_INSTANCE
  REPORTS_DASHBOARDS
  MY_COLLECTIONS
  ORDER
  PAYMENT_ROYALTY
  CONTENT_UNLOCK
  NFC_TAG_CLAIM
  BRAND_ARTIST_RECORD
  EMPLOYEE_ROLE_MGMT
  AUDIT_LOG
  NOTIFICATION_CONFIG
  SEARCH_DISCOVER
  OPS_DASHBOARD_INFRA
  PLATFORM_CONFIG
  ASSETS_DOCUMENTS_UPLOAD
  GENERAL_LOCATION
  AGE_SPECIFIC_FLAG
  ADDRESS
  /// Running THIS application: releases, logs, diagnostics, app config.
  /// Technical domain — no business role holds these.
  APPLICATION
  /// Running the platform it sits on: nodes, networking, provisioning.
  /// Technical domain — no business role holds these.
  INFRASTRUCTURE
}

/// The two authorization domains. Domain is a hard boundary, not a label: a
/// role may only be granted permissions of its own domain, so business roles
/// never acquire deploy rights and technical roles never acquire refund
/// rights. Cross-domain access is expressed by giving a person two role
/// assignments, never by widening one role.
enum AuthorizationDomain {
  BUSINESS
  TECHNICAL
}

/// How far a permission reaches, along two axes at once — *breadth* (whose
/// records) and *visibility* (how much of each record). The engine resolves
/// both from this single value (see SCOPE_REACH in the permission catalog):
///
///   value          breadth        visibility
///   ─────────────  ─────────────  ──────────
///   GLOBAL         all records    full
///   ORG            one org        full
///   OWN            actor's own    full
///   MASKED_PARTIAL all records    partially redacted   (e.g. Order Manager)
///   MASKED         all records    fully redacted       (e.g. Support)
///   PUBLIC         all records    public fields only   (e.g. buyer browsing)
///
/// Two roles can therefore hold the *same* capability at different
/// visibilities — `buyer-profile:read:masked` for Support vs
/// `buyer-profile:read:masked-partial` for the Order Manager — and one
/// endpoint serves both, shaping its response from the granted scope the
/// engine returns.
enum PermissionScope {
  GLOBAL
  ORGANIZATION
  OWN
  PUBLIC
  MASKED
  MASKED_PARTIAL
}

/// How wide a role assignment reaches: everything (GLOBAL), one organization
/// (ORG, with scopeId set), or only the actor's own records (OWN).
enum RoleScopeType {
  ORGANIZATION
  OWN
  GLOBAL
}
