// ============================================================================
// ARTIST MODULE SCHEMA  (packages/artist/prisma/artist.prisma)
// Merged by shared/database/scripts/merge-schema.mjs.
//
// Owns: Artist, ArtistCollection, ArtistBrandLink
// ============================================================================

/// A creator's public identity. Optionally linked to a platform User (a
/// claimed, self-managed artist profile) and/or to an Organization (a brand
/// that manages the artist). Both are nullable so an artist can be catalogued
/// before either link exists.
model Artist {
  id                   String        @id @db.Uuid
  name                 String
  slug                 String        @unique
  bio                  String?
  avatarUrl            String?
  coverUrl             String?
  genre                String?
  isPublic             Boolean
  organizationId       String?       @db.Uuid
  organization         Organization? @relation(fields: [organizationId], references: [id])
  /// Unique — one User can back at most one Artist profile.
  userId               String?       @unique @db.Uuid
  user                 User?         @relation(fields: [userId], references: [id])
  complianceAttestedAt DateTime?
  /// User id of the staff member who attested compliance. Intentionally NOT a
  /// foreign key — an attestation must survive that account being removed.
  complianceAttestedBy String?       @db.Uuid
  isActive             Boolean
  archivedAt           DateTime?
  createdAt            DateTime
  updatedAt            DateTime

  // ── Own-module back-relations ─────────────────────────────────────────────
  artistCollections ArtistCollection[]
  artistBrandLinks  ArtistBrandLink[]

  // ── Cross-module back-relations ───────────────────────────────────────────
  products      Product[]
  productClaims ProductClaim[]
  mediaAssets   MediaAsset[]
  royaltyRules  RoyaltyRule[]
  follows       Follow[]
}

/// A curated series of products by one artist — the unit buyers try to
/// complete. `position` orders collections on the artist's page.
model ArtistCollection {
  id             String        @id @db.Uuid
  name           String
  slug           String        @unique
  description    String?
  heroImageUrl   String?
  position       Int
  artistId       String        @db.Uuid
  artist         Artist        @relation(fields: [artistId], references: [id])
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isPublic       Boolean
  isActive       Boolean
  archivedAt     DateTime?
  createdAt      DateTime
  updatedAt      DateTime

  // ── Cross-module back-relations ───────────────────────────────────────────
  products       Product[]
  productClaims  ProductClaim[]
  mediaAssets    MediaAsset[]
  contentBundles ContentBundle[]
  evolutionRules EvolutionRule[]
  royaltyRules   RoyaltyRule[]
}

/// A time-bounded commercial relationship between an artist and a brand.
/// The composite unique lets the same pair hold several link types at once
/// (e.g. PRIMARY plus MERCHANDISE) but never duplicate one.
model ArtistBrandLink {
  id             String              @id @db.Uuid
  artistId       String              @db.Uuid
  artist         Artist              @relation(fields: [artistId], references: [id])
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id])
  linkType       ArtistBrandLinkType
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean
  createdAt      DateTime

  @@unique([artistId, organizationId, linkType])
}

/// What an artist ↔ brand link covers.
enum ArtistBrandLinkType {
  PRIMARY
  MERCHANDISE
  DISTRIBUTION
}
